@page "/resumes/wizard"
@inherits ReactiveInjectableComponentBase<ResumeWizardViewModel>
@attribute [Authorize]

@if (ViewModel != null)
{
    <MudStepper>
        <MudStep Title="Profile">
            <UserProfileLoaderView ViewModel="ViewModel.UserProfile" />
        </MudStep>
        <MudStep Title="Positions">
            <PositionsView ViewModel="ViewModel.Positions" />
        </MudStep>
        <MudStep Title="Education">
            <EducationsView ViewModel="ViewModel.Educations" />
        </MudStep>
        <MudStep Title="Recommendations">
            <RecommendationsView ViewModel="ViewModel.Recommendations" />
        </MudStep>
        <MudStep Title="Projects">
            <ProjectsView ViewModel="ViewModel.Projects" />
        </MudStep>
        <MudStep Title="Publications">
            <PublicationsView ViewModel="ViewModel.Publications" />
        </MudStep>
    </MudStepper>   
}

@code {
    protected override Task OnInitializedAsync()
    {
        if(ViewModel != null)
        {
            ViewModel.Positions.Entities.CollectionChanged += async (s, e) =>
            {
                foreach(var pos in e?.NewItems?.OfType<PositionViewModel>() ?? [])
                {
                    await pos.Load.Execute().GetAwaiter();
                }
                await InvokeAsync(StateHasChanged);
            };
            ViewModel.Educations.Entities.CollectionChanged += async (s, e) =>
            {
                await InvokeAsync(StateHasChanged);
            };
            ViewModel.Recommendations.Entities.CollectionChanged += async (s, e) =>
            {
                await InvokeAsync(StateHasChanged);
            };
            ViewModel.Projects.Entities.CollectionChanged += async (s, e) =>
            {
                foreach (var pos in e?.NewItems?.OfType<ProjectViewModel>() ?? [])
                {
                    await pos.Load.Execute().GetAwaiter();
                }
                await InvokeAsync(StateHasChanged);
            };
            ViewModel.Publications.Entities.CollectionChanged += async (s, e) =>
            {
                await InvokeAsync(StateHasChanged);
            };
        }
        return base.OnInitializedAsync();
    }
}
