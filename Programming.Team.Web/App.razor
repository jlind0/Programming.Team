<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <CascadingValue Value="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">

                    <!-- While checking authentication -->
                    <Authorizing>
                        <LayoutView Layout="@typeof(MainLayout)">
                            <PageTitle>Authorizing…</PageTitle>
                            <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
                                <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6 max-w-sm w-full text-center">
                                    <div class="mb-4">
                                        <div class="animate-spin h-8 w-8 border-2 border-gray-300 border-t-blue-600 rounded-full mx-auto"></div>
                                    </div>
                                    <h1 class="text-lg font-semibold text-gray-900">Verifying Access</h1>
                                    <p class="text-gray-600 text-sm mt-2">Please wait while we check your permissions.</p>
                                </div>
                            </div>
                        </LayoutView>
                    </Authorizing>

                    <!-- Not Authorized -->
                    <NotAuthorized Context="outerContext">
                        <LayoutView Layout="@typeof(MainLayout)">
                            <PageTitle>Access Denied</PageTitle>

                            <AuthorizeView>
                                <!-- Unauthenticated user -->
                                <NotAuthorized Context="unauthenticated">
                                    <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
                                        <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6 max-w-sm w-full text-center">
                                            <div class="mb-4">
                                                <div class="mx-auto flex items-center justify-center w-10 h-10 rounded-full bg-yellow-100">
                                                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 .667-.333 1-1 1s-1-.333-1-1 .333-1 1-1 1 .333 1 1zm-1 4h.01M5.5 20h13a2.5 2.5 0 002.5-2.5V6.5A2.5 2.5 0 0018.5 4h-13A2.5 2.5 0 003 6.5v11A2.5 2.5 0 005.5 20z"/>
                                                    </svg>
                                                </div>
                                            </div>
                                            <h1 class="text-lg font-semibold text-gray-900 mb-2">Authentication Required</h1>
                                            <p class="text-gray-600 text-sm mb-4">You must be signed in to access this page.</p>
                                            <div class="space-y-3">
                                                <LoginLink />
                                                <a href="/" class="block w-full px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                                                    Return to Homepage
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </NotAuthorized>

                                <!-- Authenticated but forbidden -->
                                <Authorized Context="authenticated">
                                    <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
                                        <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6 max-w-sm w-full text-center">
                                            <div class="mb-4">
                                                <div class="mx-auto flex items-center justify-center w-10 h-10 rounded-full bg-red-100">
                                                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M4.93 4.93a10 10 0 1114.14 14.14A10 10 0 014.93 4.93z" />
                                                    </svg>
                                                </div>
                                            </div>
                                            <h1 class="text-lg font-semibold text-gray-900 mb-2">Access Denied</h1>
                                            <p class="text-gray-600 text-sm mb-4">You don’t have permission to view this page.</p>
                                            <div class="space-y-3">
                                                <div class="bg-red-50 border border-red-200 rounded-md p-3 text-sm text-red-700">
                                                    Contact your administrator if you believe this is an error.
                                                </div>
                                                <a href="/" class="block w-full px-4 py-2 rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                                                    Return to Homepage
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </LayoutView>
                    </NotAuthorized>
                </AuthorizeRouteView>

                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </CascadingValue>
        </Found>

        <!-- Not Found Page -->
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <PageTitle>Page Not Found</PageTitle>
                <div class="not-authorized-area">
                    <h1 class="not-authorized-icon text-2xl font-bold text-gray-900 mb-2"> &#8252;</h1>
                        <p class="not-authorized-text">You are not authorized view the page. Please signin..</p>
                      
                   
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
